{
  "id": "captain-remote",
  "name": "Captain Remote",
  "description": "Authenticated Captain-only report ingress for coding agents.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "databasePath": {
        "type": "string",
        "description": "Optional SQLite database path override."
      },
      "maxRequestBytes": {
        "type": "number",
        "minimum": 1,
        "maximum": 262144,
        "default": 262144
      },
      "executionTimeoutMs": {
        "type": "number",
        "minimum": 1,
        "maximum": 300000,
        "default": 300000
      },
      "maxGlobalActiveTurns": {
        "type": "number",
        "minimum": 1,
        "maximum": 32,
        "default": 32
      },
      "maxGlobalRunningTurns": {
        "type": "number",
        "minimum": 1,
        "maximum": 4,
        "default": 4
      },
      "pollPerMinute": {
        "type": "number",
        "minimum": 1,
        "maximum": 30,
        "default": 30
      },
      "pollBurst": {
        "type": "number",
        "minimum": 1,
        "maximum": 5,
        "default": 5
      },
      "invalidAuthPerSourcePerMinute": {
        "type": "number",
        "minimum": 1,
        "maximum": 10,
        "default": 10
      },
      "invalidAuthPerSourceBurst": {
        "type": "number",
        "minimum": 1,
        "maximum": 5,
        "default": 5
      },
      "invalidAuthGlobalPerMinute": {
        "type": "number",
        "minimum": 1,
        "maximum": 100,
        "default": 100
      }
    }
  }
}
